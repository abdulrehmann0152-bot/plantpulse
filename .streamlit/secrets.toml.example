# HOW TO USE THIS FILE
# On Streamlit Community Cloud: open your app, then Manage app > Settings > Secrets, and paste ONE line like the one below with your real address.
# On your own computer (optional): copy this file to .streamlit/secrets.toml and edit it. That file is ignored by git.
# NEVER commit a real secrets.toml, and never paste the real address into chat, screenshots or GitHub.

DATABASE_URL = "postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
